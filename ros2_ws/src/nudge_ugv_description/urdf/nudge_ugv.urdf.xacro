<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="nudge_ugv">
  <xacro:arg name="body_length" default="0.45"/>
  <xacro:arg name="body_width" default="0.32"/>
  <xacro:arg name="body_height" default="0.16"/>
  <xacro:arg name="body_mass" default="10.0"/>
  <xacro:arg name="wheel_radius" default="0.08"/>
  <xacro:arg name="wheel_width" default="0.04"/>
  <xacro:arg name="wheel_separation" default="0.30"/>
  <xacro:arg name="max_linear_speed" default="0.8"/>
  <xacro:arg name="max_angular_speed" default="1.5"/>
  <xacro:arg name="use_imu" default="true"/>

  <xacro:property name="body_length" value="$(arg body_length)"/>
  <xacro:property name="body_width" value="$(arg body_width)"/>
  <xacro:property name="body_height" value="$(arg body_height)"/>
  <xacro:property name="body_mass" value="$(arg body_mass)"/>
  <xacro:property name="wheel_radius" value="$(arg wheel_radius)"/>
  <xacro:property name="wheel_width" value="$(arg wheel_width)"/>
  <xacro:property name="wheel_separation" value="$(arg wheel_separation)"/>
  <!-- Limits are exported as Xacro parameters for future backend/controller configuration. -->
  <xacro:property name="max_linear_speed" value="$(arg max_linear_speed)"/>
  <xacro:property name="max_angular_speed" value="$(arg max_angular_speed)"/>

  <material name="nudge_blue"><color rgba="0.10 0.32 0.55 1.0"/></material>
  <material name="wheel_black"><color rgba="0.04 0.04 0.04 1.0"/></material>
  <material name="sensor_gray"><color rgba="0.45 0.48 0.50 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + body_height / 2.0}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="nudge_blue"/>
    </visual>
    <collision>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="${body_mass}"/>
      <inertia
        ixx="${body_mass * (body_width * body_width + body_height * body_height) / 12.0}"
        ixy="0" ixz="0"
        iyy="${body_mass * (body_length * body_length + body_height * body_height) / 12.0}"
        iyz="0"
        izz="${body_mass * (body_length * body_length + body_width * body_width) / 12.0}"/>
    </inertial>
  </link>

  <xacro:macro name="drive_wheel" params="side y_position">
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.0017" ixy="0" ixz="0" iyy="0.0032" iyz="0" izz="0.0017"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y_position} ${-body_height / 2.0}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="30" velocity="${max_linear_speed / wheel_radius}"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left" y_position="${wheel_separation / 2.0}"/>
  <xacro:drive_wheel side="right" y_position="${-wheel_separation / 2.0}"/>

  <link name="caster_link">
    <visual><geometry><sphere radius="0.04"/></geometry><material name="wheel_black"/></visual>
    <collision><geometry><sphere radius="0.04"/></geometry></collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000128" ixy="0" ixz="0" iyy="0.000128" iyz="0" izz="0.000128"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${-body_length * 0.38} 0 ${-(wheel_radius + body_height / 2.0) + 0.04}"/>
  </joint>

  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.045" length="0.05"/></geometry><material name="sensor_gray"/></visual>
    <collision><geometry><cylinder radius="0.045" length="0.05"/></geometry></collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00007" ixy="0" ixz="0" iyy="0.00007" iyz="0" izz="0.00010"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.08 0 ${body_height / 2.0 + 0.025}"/>
  </joint>

  <xacro:if value="$(arg use_imu)">
    <link name="imu_link">
      <visual><geometry><box size="0.04 0.03 0.015"/></geometry><material name="sensor_gray"/></visual>
      <collision><geometry><box size="0.04 0.03 0.015"/></geometry></collision>
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000003" iyz="0" izz="0.000004"/>
      </inertial>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0 ${body_height / 2.0 + 0.01}"/>
    </joint>
  </xacro:if>
</robot>
